PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Database Configuration
JDBC_URL=jdbc:postgresql://your-db-host:5432/music_catalog_db?sslmode=require
DB_HOST=your-db-host
DB_PORT=5432
DB_NAME=music_catalog_db
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password

JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRATION_MS=86400000

ITUNES_API_BASE_URL=https://itunes.apple.com
OPENAI_API_KEY=your_groq_api_key_here
OPENAI_MODEL=gpt-4o-mini

ALLOWED_ORIGINS=http://localhost:5173,https://music-catalog.vercel.app
